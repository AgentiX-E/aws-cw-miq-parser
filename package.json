{
  "name": "@agentix-e/aws-cw-miq-parser",
  "version": "0.5.0",
  "description": "A TypeScript parser for AWS CloudWatch Metrics Insights queries — transforms MIQ query strings into structured JSON ASTs",
  "type": "module",
  "main": "./dist/source/index.js",
  "types": "./dist/source/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/source/index.d.ts",
      "import": "./dist/source/index.js"
    },
    "./parser": {
      "types": "./dist/source/parser.d.ts",
      "import": "./dist/source/parser.js"
    },
    "./validator": {
      "types": "./dist/source/validator.d.ts",
      "import": "./dist/source/validator.js"
    },
    "./serializer": {
      "types": "./dist/source/serializer.d.ts",
      "import": "./dist/source/serializer.js"
    },
    "./linter": {
      "types": "./dist/source/linter.d.ts",
      "import": "./dist/source/linter.js"
    },
    "./visitor": {
      "types": "./dist/source/visitor.d.ts",
      "import": "./dist/source/visitor.js"
    },
    "./errors": {
      "types": "./dist/source/errors.d.ts",
      "import": "./dist/source/errors.js"
    },
    "./types": {
      "types": "./dist/source/types.d.ts",
      "import": "./dist/source/types.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "cw-miq": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:grammar": "tsx scripts/build-grammar.ts",
    "build": "pnpm run build:grammar && tsc -p tsconfig.build.json",
    "dev": "tsx watch source/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run test/property/",
    "test:bench": "vitest bench --run",
    "docs": "typedoc",
    "docs:open": "typedoc && open docs/api/index.html",
    "lint": "eslint source/ test/ cli/ scripts/",
    "lint:fix": "eslint --fix source/ test/ cli/ scripts/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "keywords": [
    "aws",
    "cloudwatch",
    "metrics-insights",
    "parser",
    "query-parser",
    "ast",
    "typescript",
    "peggy",
    "observability"
  ],
  "license": "MIT",
  "author": "AgentiX-E",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentiX-E/aws-cw-miq-parser.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^4.9.0",
    "peggy": "^4.2.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "chalk": "^5.4.0",
    "magic-string": "^0.30.0",
    "zod": "^3.23.0"
  }
}
